# ============================================
# CloudWise AI — Environment Configuration
# Copy this file to .env and update required values
# Running on Docker: Use docker-compose up -d
# ============================================

# --- Application Environment ---
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=info

# --- Secret Keys (Change these in production!) ---
SECRET_KEY=change-me-to-a-random-64-char-string-minimum
JWT_SECRET_KEY=change-me-jwt-secret-key-64-chars-minimum
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Frontend Configuration ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=CloudWise AI
FRONTEND_PORT=3000

# --- Backend Configuration ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=["http://localhost:3000"]

# --- PostgreSQL Database ---
POSTGRES_USER=cloudwise
POSTGRES_PASSWORD=cloudwise_secret
POSTGRES_DB=cloudwise_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://cloudwise:cloudwise_secret@postgres:5432/cloudwise_db

# --- Redis Cache (Optional password) ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://redis:6379/0

# --- LLM Configuration (OpenAI) ---
# Required for AI features - get from https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-api-key-here
LLM_MOCK_MODE=false

# --- Alternative LLM Providers (Optional) ---
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# --- Stripe Payment Integration (Optional) ---
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# --- GitHub OAuth (Optional for GitHub integration) ---
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_CALLBACK_URL=http://localhost:3000/auth/callback/github

# --- Email Configuration (Optional) ---
EMAIL_PROVIDER=smtp
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=your_email@gmail.com
EMAIL_SMTP_PASSWORD=your_app_password
EMAIL_FROM_NAME=CloudWise AI
EMAIL_FROM_ADDRESS=support@cloudwise.ai

# --- ChromaDB Configuration (RAG) ---
CHROMA_HOST=chromadb
CHROMA_PORT=8002
CHROMA_COLLECTION_NAME=cloudwise_documents

# --- Storage Configuration (Optional - S3) ---
S3_BUCKET_NAME=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Advanced Database Configuration (Optional) ---
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30
DATABASE_ECHO=false

# --- Advanced Redis Configuration (Optional) ---
REDIS_DB=0
REDIS_SOCKET_TIMEOUT=5

# --- Rate Limiting (Optional) ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=3600

# --- Admin Panel (Optional - default false) ---
ADMIN_PANEL_ENABLED=false
ADMIN_SECRET_KEY=change-me-admin-secret

# --- Logging Configuration ---
LOG_FORMAT=json
LOG_OUTPUT=stdout

