# ============================================
# CloudWise AI — Environment Variables
# ============================================

# --- General ---
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-to-a-random-64-char-string

# --- Backend (FastAPI) ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=["http://localhost:3000"]

# --- Frontend (Next.js) ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=CloudWise AI

# --- PostgreSQL ---
POSTGRES_USER=cloudwise
POSTGRES_PASSWORD=cloudwise_secret
POSTGRES_DB=cloudwise_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://cloudwise:cloudwise_secret@postgres:5432/cloudwise_db

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# --- JWT ---
JWT_SECRET_KEY=change-me-jwt-secret-key-64-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- LLM (Optional — mock mode by default) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_MOCK_MODE=true

# --- Stripe (Optional) ---
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# --- ChromaDB ---
CHROMA_HOST=chromadb
CHROMA_PORT=8002
